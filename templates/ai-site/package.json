{
  "name": "@shipwords/template-ai-site",
  "private": true,
  "type": "module",
  "devPort": 5010,
  "scripts": {
    "dev": "node ../../tools/dev-port.mjs vite dev",
    "build": "vite build",
    "preview": "vite build --outDir .preview && node ../../tools/dev-port.mjs vite preview --outDir .preview",
    "typecheck": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide && tsr generate && wrangler types && tsc --noEmit",
    "check": "pnpm typecheck && pnpm build && node ../../tools/check-site.mjs .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "vite build && node ../../tools/check-site.mjs . && wrangler deploy",
    "deploy:preview": "vite build && node ../../tools/check-site.mjs . && wrangler versions upload"
  },
  "dependencies": {
    "@shipwords/core": "workspace:*",
    "@shipwords/jobs": "workspace:*",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.4",
    "better-auth": "1.7.14",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.65.0",
    "@cloudflare/workers-types": "5.20261027.1",
    "@inlang/paraglide-js": "2.27.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/router-cli": "1.167.46",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "wrangler": "4.153.0"
  }
}
