# Copy to ~/.config/shipwords/<site>.dev.vars outside the repo, then run pnpm setup:worktree to link it in. Never commit real values.
# Get a key at https://yir.ai/?utm_source=shipwords&utm_medium=starter — without it, set UPSTREAM_MOCK=1 to run with a mock upstream.
YIR_API_KEY=
APP_URL=http://localhost:5173
BETTER_AUTH_SECRET=replace-with-32-random-bytes
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Payments: fill the group matching billing.provider in site.config.ts. Use test keys locally; run node ../../tools/stripe-listen.mjs in the site dir to forward webhooks, and it writes whsec back to .dev.vars.
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# For PayPal fill this group and leave Stripe empty; use sandbox locally.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
RECAPTCHA_SITE_KEY=
RECAPTCHA_PROJECT_ID=
RECAPTCHA_API_KEY=
GUEST_COOKIE_SECRET=replace-with-32-random-bytes
# Test flows for free: 1 = outputs are replaced with reference assets; fail = every segment fails (tests refunds). Only applies when APP_URL is local, or on a public demo whose payment keys are all test-mode.
UPSTREAM_MOCK=1
