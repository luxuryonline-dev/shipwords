{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tinydeskaigenerator",
  "account_id": "a18a082313f9d93251d07fbacdfe60e1",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "routes": [{ "pattern": "tinydeskaigenerator.org", "custom_domain": true }],
  "vars": {
    "APP_URL": "https://tinydeskaigenerator.org",
    "EMAIL_FROM": "noreply@tinydeskaigenerator.org",
    // Rybbit collector URL, used only inside the Worker (/stats/* proxy); leave empty to disable.
    "RYBBIT_UPSTREAM": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tinydeskaigenerator-db",
      "database_id": "adc7a319-9c8f-47c5-a695-e6beebb72752",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "OUTPUTS", "bucket_name": "tinydeskaigenerator-outputs" }],
  "workflows": [
    {
      "name": "tinydeskaigenerator-generation",
      "binding": "GENERATION_WORKFLOW",
      "class_name": "GenerationWorkflow"
    }
  ],
  "containers": [
    {
      "class_name": "ComposeContainer",
      "scheduling_policy": "durable_object",
      "images": { "compose": { "dockerfile": "../../packages/jobs/compose/Dockerfile" } }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "COMPOSE", "class_name": "ComposeContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ComposeContainer"] }],
  // Add the EMAIL binding after verifying Email Sending for this domain.
  // Local dev neither builds nor runs the container (no Docker needed); with UPSTREAM_MOCK=1 the mock composer is used instead.
  "dev": { "enable_containers": false }
}
